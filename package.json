{
    "name": "crafleet-workspace",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.18.0",
    "engines": {
        "node": ">=24.11.1 <27"
    },
    "scripts": {
        "format": "node scripts/quality.mjs format",
        "check": "node scripts/quality.mjs check",
        "check:fix": "node scripts/quality.mjs fix",
        "format:java": "node scripts/java-quality.mjs format",
        "check:java": "node scripts/java-quality.mjs check",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --project unit",
        "test:watch": "vitest --project unit",
        "bench:config": "vitest bench --run packages/adapters/src/filesystem/config-secrets.bench.ts",
        "bench:config-io": "vitest bench --run packages/adapters/src/filesystem/config-io.bench.ts",
        "test:integration": "vitest run --project integration",
        "test:coverage": "vitest run --project unit --project integration --coverage",
        "test:e2e": "vitest run --project e2e",
        "test:completion": "node tests/support/test-shell-completion.mjs",
        "test:package": "node scripts/test-package.mjs",
        "check:architecture": "node scripts/check-architecture.mjs",
        "check:release-notes": "node scripts/release-notes.mjs --check",
        "build:addons": "node addons/build.mjs",
        "test:addons": "node addons/test-servers.mjs",
        "build": "pnpm build:addons && tsdown && node scripts/build-assets.mjs",
        "verify": "pnpm build:addons && pnpm check && pnpm typecheck && pnpm check:architecture && pnpm check:release-notes && pnpm test:coverage && pnpm build && pnpm test:package",
        "release:prepare": "pnpm verify && node scripts/release.mjs prepare",
        "release:check": "node scripts/release-notes.mjs --check && node scripts/release.mjs check",
        "release:publish": "node scripts/release-notes.mjs --check && node scripts/release.mjs publish"
    },
    "devDependencies": {
        "@crafleet/core": "workspace:*",
        "@crafleet/adapters": "workspace:*",
        "@biomejs/biome": "2.6.7",
        "@types/node": "26.6.6",
        "@vitest/coverage-v8": "5.1.0",
        "arktype": "2.2.9",
        "tsdown": "0.23.7",
        "typescript": "7.0.2",
        "vitest": "5.1.0",
        "yaml": "2.9.1"
    }
}
